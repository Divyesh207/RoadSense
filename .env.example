# ==============================================================================
# Road Intelligence & Pothole Management Platform - Environment Configuration
# ==============================================================================

# Application
APP_ENV=development
APP_NAME="Road Intelligence & Pothole Management Platform"
APP_VERSION=1.0.0
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=replace-with-a-secure-random-secret-key-min-32-chars

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Database (PostgreSQL + PostGIS)
# For local Docker: postgresql+asyncpg://postgres:postgres@postgres:5432/road_platform
# For local direct: postgresql+asyncpg://postgres:postgres@localhost:5432/road_platform
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/road_platform
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/road_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=road_platform
POSTGRES_PORT=5432

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Authentication & Security
JWT_SECRET=replace-with-a-secure-jwt-secret-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
BCRYPT_ROUNDS=12

# Supabase (Managed PostgreSQL & Object Storage)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=replace-with-anon-key
# Server-side ONLY! Never expose to Web browser or Android clients:
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Storage Buckets
SUPABASE_STORAGE_BUCKET_INSPECTION_MEDIA=inspection-media
SUPABASE_STORAGE_BUCKET_REPAIR_EVIDENCE=repair-evidence
SUPABASE_STORAGE_BUCKET_REPORTS=reports
SUPABASE_STORAGE_BUCKET_MODEL_ARTIFACTS=model-artifacts

# Storage backend: auto (Supabase when SUPABASE_URL + SERVICE_ROLE_KEY are set,
# otherwise local disk outside production), supabase, or local (dev/demo only).
STORAGE_BACKEND=auto
LOCAL_STORAGE_ROOT=./data/media
# Externally reachable API base used in locally signed upload/download URLs.
# Testing the Android app on a physical phone: use this PC's Wi-Fi LAN address,
# e.g. http://192.168.1.50:8000/api/v1 (localhost on the phone is the phone).
PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
SIGNED_UPLOAD_EXPIRES_SECONDS=900
SIGNED_DOWNLOAD_EXPIRES_SECONDS=3600

# AI / ML Configuration
AI_MODEL_DIR=./data/models
YOLO_MODEL_PATH=./data/models/pothole_yolov8.pt
SEVERITY_MODEL_PATH=./data/models/severity_xgb.json
PREDICTION_MODEL_PATH=./data/models/deterioration_xgb.json
AI_DEVICE=cpu
# Refuse to fall back to the OpenCV heuristic when trained YOLO weights are missing
# (recommended for staging/production). Optional provenance sidecar: <weights>.json
AI_REQUIRE_TRAINED_MODEL=false
AI_CONFIDENCE_THRESHOLD=0.35
AI_NMS_IOU_THRESHOLD=0.45

# Optional extra CA for Docker builds behind HTTPS interception (infrastructure/certs/README.md)
# EXTRA_CA_CERT_FILE=./infrastructure/certs/local-extra-ca.pem

# Web Application
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_ENV=development
